# Supabase (public values only — safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: canonical site URL used in password-reset emails (defaults to request host)
# NEXT_PUBLIC_SITE_URL=https://tournament-watcher.vercel.app

# --- Server-only (never NEXT_PUBLIC_) ---------------------------------------

# Playwright render worker (see /worker). When set, pages behind a bot
# challenge are rendered there and parsed by the same adapters.
# WATCHER_WORKER_URL=https://bbm-worker.up.railway.app
# WATCHER_WORKER_TOKEN=same-random-secret-as-the-worker
# WATCHER_PREFER_BROWSER=1   # skip the plain fetch and always render in the browser

# Structured logs are always on; set LOG_LEVEL=debug for per-step detail.
# LOG_LEVEL=info

# Scheduled refresh (POST /api/cron/refresh) so matches update while phones are locked.
# The worker's scheduler calls it with CRON_SECRET; it needs the service-role key to
# refresh every owner's athletes without a user session.
# CRON_SECRET=another-random-secret
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Settings → API → service_role (server-side only!)

# --- Payments: MyFatoorah (prepared, feature-flagged; see docs/payments.md) ---
# Nothing payment-related runs unless PAYMENTS_MYFATOORAH_ENABLED=1 AND both
# secrets are set. Leave all four empty to keep the webhook route answering 404.
# PAYMENTS_MYFATOORAH_ENABLED=1
# MYFATOORAH_API_KEY=                # Portal → Integration Settings → API Key (Bearer token)
# MYFATOORAH_WEBHOOK_SECRET=         # Portal → Integration Settings → Webhook Settings → secret key
# MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com   # production (Qatar): https://api-qa.myfatoorah.com

# Telegram alerts (optional, off by default). GO TO MAT / ON MAT / mat and time
# changes are sent to a linked chat whenever a refresh runs. See docs/telegram.md.
# TELEGRAM_ENABLED=1                 # "1" turns the channel on; anything else = off
# TELEGRAM_BOT_TOKEN=                # from @BotFather (server-side only!)
# TELEGRAM_WEBHOOK_SECRET=           # random string (>= 8 chars) passed to setWebhook as secret_token
# TELEGRAM_BOT_USERNAME=             # optional, without @; shown in the linking instructions
