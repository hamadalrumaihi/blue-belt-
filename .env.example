# Supabase (public values only — safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: canonical site URL used in password-reset emails (defaults to request host)
# NEXT_PUBLIC_SITE_URL=https://bluebeltmedia.vercel.app   # also used for links in Telegram operational alerts

# --- Server-only (never NEXT_PUBLIC_) ---------------------------------------

# Playwright render worker (see /worker). When set, pages behind a bot
# challenge are rendered there and parsed by the same adapters.
# WATCHER_WORKER_URL=https://bbm-worker.up.railway.app
# WATCHER_WORKER_TOKEN=same-random-secret-as-the-worker
# WATCHER_PREFER_BROWSER=1   # skip the plain fetch and always render in the browser

# Structured logs are always on; set LOG_LEVEL=debug for per-step detail.
# LOG_LEVEL=info

# Scheduled refresh (POST /api/cron/refresh) so matches update while phones are locked.
# The worker's scheduler calls it with CRON_SECRET; it needs the service-role key to
# refresh every owner's athletes without a user session.
# CRON_SECRET=another-random-secret
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Settings → API → service_role (server-side only!)
# The same service-role key also enables machine capture intake (/api/capture/*) for the
# Windows agent; the agent itself only ever holds a capture credential (Settings → Capture agent).

# --- Payments: MyFatoorah (prepared, feature-flagged; see docs/payments.md) ---
# Nothing payment-related runs unless PAYMENTS_MYFATOORAH_ENABLED=1 AND both
# secrets are set. Leave all four empty to keep the webhook route answering 404.
# PAYMENTS_MYFATOORAH_ENABLED=1
# MYFATOORAH_API_KEY=                # Portal → Integration Settings → API Key (Bearer token)
# MYFATOORAH_WEBHOOK_SECRET=         # Portal → Integration Settings → Webhook Settings → secret key
# MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com   # production (Qatar): https://api-qa.myfatoorah.com
# PAYMENTS_RECONCILE_ENABLED=1       # lets POST /api/cron/payments call GetPaymentStatus for old pending bookings (off = no provider calls)
# PAYMENTS_AUTO_INVOICE_ENABLED=1    # lets POST /api/cron/payments auto-create a MyFatoorah invoice for unpaid OFFLINE orders (Fawran/bank/cash); card orders are already paid in Pic-Time and are skipped. Off = no invoices are created automatically. Never messages the customer; the payment link is stored on the order for the owner to send.

# --- Bookings: deposit and balance policy (see docs/payments.md, "Deposit and balance") ---
# Read by src/lib/bookings/policy.ts with fail-safe defaults: a missing or malformed value never
# switches the deposit OFF. The server splits every total into the two stages; browsers never send amounts.
# BOOKINGS_DEPOSIT_REQUIRED=1        # "1" (default) = a deposit must be paid before a booking is confirmed; "0" = no deposit stage
# BOOKINGS_DEPOSIT_PERCENT=50        # share of the total taken as the deposit (1..100, default 50); the balance is the rest
# BOOKINGS_BALANCE_TIMING=after_delivery   # when the balance becomes due; "after_delivery" is the only supported value (default)

# --- E-signature (contracts and releases; see src/lib/esign) ----------------
# ESIGN_PROVIDER picks how agreements are signed. "internal" (default) is the
# studio's own typed-name signing page at /sign/<token>; nothing else is needed.
# "mock" is a development aid: envelopes are fake, nothing is sent, and the owner
# advances them from the booking page ("Test signing, not a real signature");
# it is ignored on a production deployment (VERCEL_ENV=production). "docusign"
# creates envelopes through the DocuSign eSignature REST API with a JWT grant
# and needs every DOCUSIGN_* value below. Customer pages never name a provider.
# ESIGN_PROVIDER=internal
# ESIGN_WEBHOOK_SECRET=              # random secret; the provider signs POST /api/esign/webhook with it (DocuSign Connect: "Include HMAC Signature" key). Endpoint answers 404 until set.
# DOCUSIGN_INTEGRATION_KEY=          # Apps and Keys → Integration Key (client id)
# DOCUSIGN_USER_ID=                  # Apps and Keys → User ID (API username GUID) of the impersonated user
# DOCUSIGN_ACCOUNT_ID=               # Apps and Keys → API Account ID
# DOCUSIGN_BASE_URL=https://demo.docusign.net   # developer sandbox; production: the account's base URI (e.g. https://eu.docusign.net)
# DOCUSIGN_PRIVATE_KEY=              # RSA private key (PEM) generated under the integration key; "\n" escapes are accepted. Server-side only!

# Telegram alerts (optional, off by default). GO TO MAT / ON MAT / mat and time
# changes are sent to a linked chat whenever a refresh runs. See docs/telegram.md.
# TELEGRAM_ENABLED=1                 # "1" turns the channel on; anything else = off
# TELEGRAM_BOT_TOKEN=                # from @BotFather (server-side only!)
# TELEGRAM_WEBHOOK_SECRET=           # random string (>= 8 chars) passed to setWebhook as secret_token
# TELEGRAM_BOT_USERNAME=             # optional, without @; shown in the linking instructions
# TELEGRAM_REMINDER_MINUTES=15,5     # pre-match reminder leads planned by the delivery runner (/api/cron/deliveries)
# TELEGRAM_DRY_RUN=1                 # log instead of sending (always the case under NODE_ENV=test / Vitest)

# --- Bracket photos (optional). Reads a bracket screenshot into reviewable rows on
# /events/<id>/brackets for manually tracked events. Server-side only; off when unset.
# ANTHROPIC_API_KEY=

# --- Orders intake: Pic-Time orders via Zapier (feature-flagged; see docs/orders-intake.md) ---
# Off by default: POST /api/orders/intake answers 404. Needs SUPABASE_SERVICE_ROLE_KEY and an
# orders intake credential (Settings → Orders intake). Records orders + an [Orders] Telegram message;
# never proves payment — Fawran / bank transfer orders stay "payment not yet confirmed" until you confirm.
# ORDERS_INTAKE_ENABLED=1

# --- Client e-mail (Resend; optional, off by default; see docs/studio-platform.md) ---
# Client notifications (booking received / confirmed, payment link, contract, gallery
# ready…) are queued in the same outbox as Telegram and sent by /api/cron/deliveries
# only when all three are set. Owner switches per kind live on /notifications.
# EMAIL_ENABLED=1
# RESEND_API_KEY=                     # https://resend.com/api-keys (server-side only!)
# EMAIL_FROM="Blue Belt Media <bookings@your-verified-domain>"
# EMAIL_REPLY_TO=hello@your-domain    # optional
# EMAIL_DRY_RUN=1                     # log instead of sending (always the case under Vitest)

# --- Website analytics: Umami (optional, off by default) ---
# Set BOTH to load Umami's script on the public website only (never in the studio or
# the client portal). Works with Umami Cloud or a self-hosted Umami; no cookies are set.
# Click events: book-start, contact-click, gallery-click, booking-submitted.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# --- Business identity (public; shown in the footer, contact page, legal pages, JSON-LD and e-mails) ---
# All optional: the registered defaults are built in. Never put the office address, QID,
# bank details or any secret here; these values are printed on the public website.
# BUSINESS_LEGAL_NAME=        # registered trading name
# BUSINESS_CR_NUMBER=         # commercial registration number
# BUSINESS_PUBLIC_LOCATION=   # city and country only, e.g. "Doha, Qatar"
# BUSINESS_CONTACT_EMAIL=     # public contact e-mail
# BUSINESS_CONTACT_PHONE=     # public phone / WhatsApp number, local 8 digits or international

# Which owner the public website books for (single tenant). Optional: when unset the
# earliest studio row with public booking switched on is used. Supabase → Authentication → Users → UID.
# STUDIO_OWNER_ID=
