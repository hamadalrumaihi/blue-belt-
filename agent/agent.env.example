# Blue Belt Media capture agent — copy to agent.env (same folder) and fill in.
# agent.env is ignored by git. Never put the Supabase service-role key here;
# the agent only ever holds a capture credential.

# The app's origin (no path).
APP_URL=https://tournament-watcher.vercel.app

# Capture credential from the app: Settings → Capture agent → Create credential.
# Starts with bbmc_. Revoke it from the same place; it also expires on its own.
CAPTURE_TOKEN=

# Optional ---------------------------------------------------------------
# chrome (installed Google Chrome, recommended) | msedge | chromium (Playwright's build)
# BROWSER_CHANNEL=chrome
# Dedicated browser profile and spool live under %LOCALAPPDATA%\BlueBeltAgent by default.
# AGENT_DATA_DIR=C:\BlueBeltAgent
# How often each bracket page is re-captured (seconds). The server also enforces one per minute.
# INTERVAL_SECONDS=60
# How long to wait for a page to show its schedule after loading (ms).
# READY_WAIT_MS=15000
# Run the browser without a window (NOT recommended on the event laptop: a human check needs the window).
# HEADLESS=0
