# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
worker/node_modules

# supabase cli scratch
supabase/.temp
agent/node_modules
agent/agent.env

# photography originals (large; keep them out of git — see photos/README.md)
photos/incoming/*
!photos/incoming/.gitkeep
# resolve-ai (python toolchain)
resolve-ai/**/.venv/
resolve-ai/**/__pycache__/
resolve-ai/**/*.egg-info/
resolve-ai/**/.pytest_cache/
# Pic-Time browser session credentials (never commit).
pictime-state.json
*.storage-state.json

# python bytecode (skills scripts)
__pycache__/
*.pyc
# BBM Studio: footage, proxies, renders and production folders never belong in git
BBM-Studio/
resolve-ai/**/*.mp4
resolve-ai/**/*.mov
resolve-ai/**/*.mxf
resolve-ai/**/*.mts
resolve-ai/**/*.braw
resolve-ai/**/_analysis/
