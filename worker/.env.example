# Required: shared secret the app sends as "Authorization: Bearer …" (16+ random chars)
WORKER_TOKEN=

# Optional
PORT=8080
ALLOWED_HOSTS=ajptour.com,smoothcomp.com
# new (Chromium new headless, default) | shell (Playwright headless shell) | headed (real window under Xvfb)
HEADLESS=new
# playwright (default) | patchright (anti-detection fork; try this first if Cloudflare does not clear)
ENGINE=playwright
PROFILE_DIR=/data/profile
NAV_TIMEOUT_MS=45000
CHALLENGE_WAIT_MS=35000
MAX_CONCURRENCY=2
# Connect to an external browser (browser-as-a-service with residential IPs) instead of launching Chromium
# BROWSER_WS_ENDPOINT=wss://…

# Optional refresh loop: tick the app every N seconds so refreshes run while phones are locked
# SCHEDULE_SECONDS=60
# APP_URL=https://tournament-watcher.vercel.app
# CRON_SECRET=   (must match the app's CRON_SECRET)
