# Required: shared secret the app sends as "Authorization: Bearer …" (16+ random chars)
WORKER_TOKEN=

# Optional
PORT=8080
ALLOWED_HOSTS=ajptour.com,smoothcomp.com
# new (Chromium new headless, default) | shell (Playwright headless shell) | headed (real window under Xvfb)
HEADLESS=new
# playwright (default) | patchright (anti-detection fork; try this first if Cloudflare does not clear)
ENGINE=playwright
PROFILE_DIR=/data/profile
NAV_TIMEOUT_MS=45000
CHALLENGE_WAIT_MS=35000
MAX_CONCURRENCY=2
# Residential proxy for Chromium. Cloudflare scores the IP first, so a data-centre
# IP (Railway, any cloud) stays challenged no matter the browser mode; a residential
# proxy is what clears it. Credentials go in the URL; the worker splits them out for Playwright.
# BROWSER_PROXY=http://user:pass@host:port
# With a per-GB proxy plan, skip images/media/fonts (try only after the challenge clears)
# PROXY_BLOCK_ASSETS=1
# Alternative: connect to an external browser (browser-as-a-service with residential IPs) instead of launching Chromium
# BROWSER_WS_ENDPOINT=wss://…

# Optional refresh loop: tick the app every N seconds so refreshes run while phones are locked
# SCHEDULE_SECONDS=60
# APP_URL=https://tournament-watcher.vercel.app
# CRON_SECRET=   (must match the app's CRON_SECRET)
